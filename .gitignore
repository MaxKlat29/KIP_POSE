# ── OS / editor junk ──────────────────────────────────────────
.DS_Store
*.swp
.idea/

# ── Secrets / local config ────────────────────────────────────
# .env holds host/IP/MAC/path config — NEVER commit it. Track only .env.example.
.env
**/.env
*.env
# ...but the placeholder template MUST stay tracked (negation, last match wins).
!.env.example
!**/.env.example
!*.env.example

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
.posevenv/
.venv-faces/
.venv-verify/
venv/
env/
*.egg-info/
.pytest_cache/

# ── Face-Atlas outputs (collages + drop records are generated) ─
faces_out/

# ── Large / binary simulation data ────────────────────────────
# USD assets are delivered separately; rendered output is generated.
# Keep the directory structure (.gitkeep) but never commit the payload.
data/usd/*
data/output/*
data/SDG/
!data/usd/.gitkeep
!data/output/.gitkeep
*.usd
*.usda
*.usdc
*.usdz

# ── transient lock / backup files ─────────────────────────────
*.lock
*.pre-bump.bak

# ── Isaac Sim / run logs ──────────────────────────────────────
*.log
kit/

# ── git worktrees (managed by `git worktree`, never commit) ────
.worktrees/

# ── claude-kanban runtime (board.json IS tracked; the rest is ephemeral) ──
.claude-kanban/bus.jsonl
.claude-kanban/checkpoints/
.claude-kanban/presence.json

# ── project/ generated artifacts (large; regenerable via setup.ipynb) ──────────
# Facesets (RGB+Tiefe+Maske) und Snippets sind generierte Trainingsdaten.
project/training_data/
# Scratch/Zwischenstände (Previews, Render-/Train-Skripte, pose_result-Outputs).
project/temp/
# E2E-Finish-Harness pulled eval reports (transient; e2e_finish.sh regeneriert sie).
results/
# Trainierte Checkpoints + Metriken (groß; via setup.ipynb erzeugbar).
project/models/*.pt
project/models/*.metrics.json
project/models/_train_summary.json
# Lokale GDRNPP-Checkpoints (4.8GB, via setup.ipynb von der Workstation pullbar).
project/models/gdrnpp/
# HQ-Variante der Maschinen-Zelle (197MB). Frontend nutzt cell_web.glb (27MB);
# cell_hq ist nur fuer Offline-Render mit voller Geometrie.
project/frontend/assets/cell_hq.glb
# Detektor-Trainings-Artefakte (Kurven-Plot + CSV; via setup.ipynb erzeugbar).
project/models/detector.curves.png
project/models/*.results.csv
# Template-Banken (Render-and-Compare; groß, via setup.ipynb/build_template_bank
# erzeugbar). bank.npz pro Teil — gitignored.
project/models/templates/
# Beispiel-Eingaben (Bilder werden lokal abgelegt, nicht committed).
project/input/*
!project/input/.gitkeep
# committet bleibt: project/models/registry/ (wertvolle Face-Registries),
# die ipynbs, e2e_infer.py, frontend/, cad_input/-Struktur (.usd selbst gitignored).
