# POSE pipeline config — copy to `.env` and fill in your own values.
#   cp project/.env.example project/.env
# `.env` is git-ignored (holds host/IP/MAC/paths) — NEVER commit it.
# Read by setup.ipynb / infer.ipynb via ENV.get(KEY, <default>); all keys are
# optional (sane defaults exist), but set them to point at your own GPU box.

# SSH target of the GPU/training box (user@host). Tailscale IP or hostname.
GPU_HOST=user@gpu-host.example

# Wake-on-LAN relay host that can reach the GPU box on the LAN (user@host).
# A small always-on machine (e.g. Raspberry Pi) that sends the WoL magic packet.
WOL_HOST=user@wol-relay.example

# MAC address of the GPU box NIC (for the Wake-on-LAN magic packet).
WOL_MAC=00:00:00:00:00:00

# Repo root on the GPU box (rsync target + run cwd).
BOX_REPO=/path/to/repo

# Python interpreters of the per-task venvs on the GPU box (see docs/REPRODUCE.md).
BOX_ISAAC_PY=/path/to/isaacsim-venv/bin/python
BOX_TRAIN_PY=/path/to/train-venv/bin/python
