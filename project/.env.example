# POSE pipeline config — copy to `.env` and fill in your own values.
#   cp project/.env.example project/.env
# `.env` is git-ignored (holds host/IP/MAC/paths) — NEVER commit it.
# Read by setup.ipynb / infer.ipynb via ENV.get(KEY, <default>) and by the
# helper shell scripts in box_src/ and scripts/. No host addresses are baked
# into the repo — the scripts abort with a clear message if a key is missing.

# ── GPU / training box ───────────────────────────────────────────────────────
# SSH target of the GPU box (user@host). Tailscale IP or hostname.
# Used by: setup.ipynb, infer.ipynb, box_src/e2e_finish.sh, scripts/pull_box_artifacts.sh
GPU_HOST=user@gpu-host.example

# Same box, split into its parts — box_src/gpu_run.sh and box_src/eval_bop.sh
# take these instead of the combined form.
BOX_USER=user
BOX_HOST=gpu-host.example

# Repo root on the GPU box (rsync target + run cwd).
BOX_REPO=/path/to/repo

# Python interpreters of the per-task venvs on the GPU box (see docs/REPRODUCE.md).
BOX_ISAAC_PY=/path/to/isaacsim-venv/bin/python
BOX_TRAIN_PY=/path/to/train-venv/bin/python

# ── Wake-on-LAN (optional; leave empty to disable waking the box) ────────────
# An always-on machine on the same LAN (e.g. a Raspberry Pi) that sends the
# magic packet, plus the MAC of the GPU box NIC.
WOL_HOST=user@wol-relay.example
WOL_RELAY=user@wol-relay.example
WOL_MAC=00:00:00:00:00:00
BOX_MAC=00:00:00:00:00:00

# ── Cell Jetson (live tab; reached over the scoped KIT VPN) ──────────────────
# Used by: box_src/kit_vpn_scoped_connect.sh (route) and project/kip_server.py.
JETSON_IP=10.0.0.2
LIVE_JETSON_URL=http://10.0.0.2:8090

# ── Service mesh (only when running project/mesh/ on the box) ────────────────
# Deploy directory of the compose stack and the GigaPose checkout it bind-mounts.
MESH_DIR=/path/to/kip_mesh
GIGAPOSE_DIR=/path/to/GigaPose
