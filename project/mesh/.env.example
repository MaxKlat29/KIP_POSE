# Host paths for docker-compose volume mounts.
#
# Copy this file to `.env` (read automatically by `docker compose`) and set
# absolute paths for your machine. If you check out FoundationPose/ and
# GigaPose/ as siblings of this repo and use the bundled YOLO weights, you
# don't need a .env at all — the compose defaults (../FoundationPose,
# ../GigaPose, ./assets/weights/best.pt) already do the right thing.

# FoundationPose checkout: code + pretrained weights (weights/...).
# Build its docker/Dockerfile.blackwell as `foundationpose:blackwell` first.
FOUNDATIONPOSE_DIR=/absolute/path/to/FoundationPose

# GigaPose checkout: code + pretrained/ + datasets/kip2 + rendered templates
# (datasets/templates/kip2) + torch_cache/. Build its docker/Dockerfile.blackwell
# as `gigapose:blackwell` first.
GIGAPOSE_DIR=/absolute/path/to/GigaPose

# YOLO26n-seg instance-segmentation checkpoint (class ids: 0=anker_kurz,
# 1=anker_lang). A trained copy is bundled at ./assets/weights/best.pt;
# point this at a different checkpoint to override it.
YOLO_WEIGHTS_PT=./assets/weights/best.pt

# YOLOv8-OBB detector checkpoint for yolo-obb-svc (oriented boxes; FROZEN 6-class
# order anker_kurz=0..zahnrad=5, the service keeps only the 2 Anker classes).
# Default ./assets/weights/detector.pt; on the box use the arm-visible retrain
# /mnt/data/kip_pose/data/detector_armvis/detector.pt.
YOLO_OBB_WEIGHTS_PT=./assets/weights/detector.pt

# HuggingFace cache containing the facebook/sam3 snapshot (gated model:
# accept the license on huggingface.co, then download once on the host, e.g.
#   hf download facebook/sam3
# sam3-svc mounts this read-only and runs fully offline).
HF_CACHE_DIR=~/.cache/huggingface
